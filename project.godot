; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="zhezhizhonghua"
config/description="游乐场"
config/version="1.0.1"
run/main_scene="res://scenes/login.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.345098, 0.698039, 0.635294, 1)
boot_splash/image="res://assets/login/chenguang.png"
config/icon="res://assets/bg/img_gg.png"

[autoload]

Nakama="*res://addons/com.heroiclabs.nakama/Nakama.gd"
Online="*res://autoload/nakama/Online.gd"
OnlineLogin="*res://autoload/nakama/OnlineLogin.gd"
OnlineChat="*res://autoload/nakama/OnlineChat.gd"
OnlineMatch="*res://autoload/nakama/OnlineMatch.gd"
Transitions="*res://addons/transitions/Transitions.gd"
FancyFade="*res://addons/transitions/FancyFade.gd"
FadeScene="*res://addons/transitions/FadeScene.gd"
WindowDrag="*res://autoload/window_drag.gd"
MailSystem="*res://autoload/mail_system.gd"
DataMgr="*res://autoload/data_manager.gd"
PopupManager="*res://autoload/popup_manager.gd"
SceneManager="*res://autoload/scene_manager.gd"
SignalManager="*res://autoload/signal_manager.gd"
SettingsManager="*res://autoload/settings_manager.gd"
Util="*res://autoload/Util.gd"

[display]

window/size/borderless=true

[editor_plugins]

enabled=PackedStringArray("res://addons/codeandweb.texturepacker/plugin.cfg", "res://addons/gdcef/plugin.cfg", "res://addons/transitions/plugin.cfg")

