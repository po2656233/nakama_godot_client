[sub_resource type="Shader" id="Shader_1mgu0"]
code = "shader_type canvas_item;

uniform sampler2D gradient_texture;
uniform float progress : hint_range(0.0, 1.0) = 0.0;
uniform float border_thickness : hint_range(0.0, 0.1) = 0.02;
uniform vec4 border_color : source_color = vec4(0.8, 0.3, 1.0, 0.2);
uniform float pulse_amplitude : hint_range(0.0, 0.1) = 0.03;
uniform float pulse_frequency = 1.5;
uniform float glow_intensity : hint_range(0.0, 1.0) = 0.3;

void fragment() {
    // 计算到中心的距离
    vec2 center = vec2(0.5, 0.5);
    float dist = distance(UV, center);
    
    // 创建圆形
    float circle_alpha = smoothstep(0.5, 0.49, dist);
    
    // 创建填充效果 (基于进度)
    float fill_cutoff = 0.5 - progress * 0.5;
    float fill_alpha = smoothstep(fill_cutoff + 0.02, fill_cutoff, dist);
    
    // 边缘发光效果 - 更柔和
    float border = smoothstep(0.2, 0.2 - border_thickness, dist) * 
                  smoothstep(fill_cutoff, fill_cutoff + border_thickness, dist);
    
    // 添加柔和的脉冲效果
    float pulse = sin(TIME * pulse_frequency) * pulse_amplitude;
    float pulse_border = smoothstep(fill_cutoff + pulse, fill_cutoff + pulse + border_thickness, dist);
    
    // 获取渐变颜色
    vec4 gradient_color = texture(gradient_texture, vec2(UV.y, 0.0));
    
    // 计算球体边缘柔和高光
    float highlight = 1.0 - smoothstep(0.0, 0.45, dist);
    highlight = pow(highlight, 2.0) * 0.8;
    
    // 组合所有效果，但降低强度
    vec4 fill_color = gradient_color * fill_alpha;
    vec4 border_effect = border_color * border * (1.0 + 0.3 * sin(TIME * pulse_frequency));
    vec4 highlight_color = vec4(1.0, 1.0, 1.0, highlight * 0.3);
    vec4 pulse_effect = border_color * pulse_border * 0.3;
    
    // 最终颜色 - 更柔和的混合
    COLOR = fill_color + border_effect + highlight_color + pulse_effect;
    COLOR.a *= circle_alpha;
    
    // 外部发光 - 更柔和
    float glow = smoothstep(0.5 + border_thickness, 0.5 - border_thickness * 2.0, dist);
    COLOR += border_color * glow * glow_intensity * (0.4 + 0.3 * sin(TIME * pulse_frequency));
}
"

