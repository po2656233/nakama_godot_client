[sub_resource type="GDScript" id="GDScript_f5fmp"]
resource_name = "joystick"
script/source = "extends CanvasLayer
@export_group(\"方向映射\")
## 向左
@export var action_left := \"ui_left\"
## 向右
@export var action_right := \"ui_right\"
## 向上
@export var action_up := \"ui_up\"
## 向下
@export var action_down := \"ui_down\"
## 激活
@export var action_accept := \"ui_accept\"

@export_group(\"功能映射\")
## x键对应的用户自定义的映射
@export var action_x := \"\"
## y键对应的用户自定义的映射
@export var action_y := \"\"
## z键对应的用户自定义的映射
@export var action_z := \"\"
## a键对应的用户自定义的映射
@export var action_a := \"\"
## b键对应的用户自定义的映射
@export var action_b := \"\"

## 当不松手时,一直触发A所映射的键
@export var a_keep_pressed := true
## 当不松手时,一直触发B所映射的键
@export var b_keep_pressed := false
## 当不松手时,一直触发X所映射的键
@export var x_keep_pressed := false
## 当不松手时,一直触发Y所映射的键
@export var y_keep_pressed := false
## 当不松手时,一直触发Z所映射的键
@export var z_keep_pressed := false


var a_pressed = false
var b_pressed = false
var x_pressed = false
var y_pressed = false
var z_pressed = false

@onready var virtual_joystick: Node2D = $VirtualJoystick
@onready var a: TouchScreenButton = $A
@onready var b: TouchScreenButton = $B
@onready var x: TouchScreenButton = $X
@onready var y: TouchScreenButton = $Y
@onready var z: TouchScreenButton = $Z


func _ready() -> void:
	a.action = action_a
	b.action = action_b
	x.action = action_x
	y.action = action_y
	z.action = action_z
	virtual_joystick.action_left = action_left
	virtual_joystick.action_right = action_right
	virtual_joystick.action_up = action_up
	virtual_joystick.action_down = action_down
	virtual_joystick.action_accept = action_accept
	pass

func _process(_delta):
	if a_pressed and a_keep_pressed:
		pressAction(action_a)
	elif b_pressed and b_keep_pressed:
		pressAction(action_b)
	elif x_pressed and x_keep_pressed:
		pressAction(action_x)
	elif y_pressed and y_keep_pressed:
		pressAction(action_y)
	elif z_pressed and z_keep_pressed:
		pressAction(action_z)
	pass

	
func pressKey(key:Key):
	# 按下事件
	var press_event = InputEventKey.new()
	press_event.physical_keycode = key
	press_event.pressed = true
	Input.parse_input_event(press_event)
	pass

func pressAction(action:String):
	# 仅在动作名非空且已在 InputMap 中注册时才触发
	if action.is_empty() or  not InputMap.has_action(action) :
		return
	# 先释放已有状态，再发送按下
	releaseAction(action)
	var event = InputEventAction.new()
	event.action = action
	event.pressed = true
	event.strength = 1.0
	Input.parse_input_event(event)
	Input.action_press(action, 1.0)
	pass

func releaseAction(action:String)->bool:
	if not action.is_empty():
		Input.action_release(action)
		return true
	return false

func _on_a_pressed() -> void:
	a_pressed = true
	pressAction(action_a)
	pass # Replace with function body.


func _on_x_pressed() -> void:
	x_pressed = true
	pressAction(action_x)
	pass # Replace with function body.


func _on_y_pressed() -> void:
	y_pressed = true
	pressAction(action_y)
	pass # Replace with function body.


func _on_b_pressed() -> void:
	b_pressed = true
	pressAction(action_b)
	pass # Replace with function body.


func _on_z_pressed() -> void:
	z_pressed = true
	pressAction(action_z)
	pass # Replace with function body.


func _on_a_button_down() -> void:
	a_pressed = true
	pressAction(action_a)
	pass # Replace with function body.


func _on_x_button_down() -> void:
	x_pressed = true
	pressAction(action_x)
	pass # Replace with function body.


func _on_y_button_down() -> void:
	y_pressed = true
	pressAction(action_y)
	pass # Replace with function body.


func _on_b_button_down() -> void:
	b_pressed = true
	pressAction(action_b)
	pass # Replace with function body.


func _on_z_button_down() -> void:
	z_pressed = true
	pressAction(action_z)
	pass # Replace with function body.


func _on_a_button_up() -> void:
	a_pressed = false
	pass # Replace with function body.


func _on_x_button_up() -> void:
	x_pressed = false
	pass # Replace with function body.


func _on_y_button_up() -> void:
	y_pressed = false
	pass # Replace with function body.


func _on_b_button_up() -> void:
	b_pressed = false
	pass # Replace with function body.


func _on_z_button_up() -> void:
	z_pressed = false
	pass # Replace with function body.


func _on_z_released() -> void:
	z_pressed = false
	pass # Replace with function body.


func _on_x_released() -> void:
	x_pressed = false
	pass # Replace with function body.


func _on_y_released() -> void:
	y_pressed = false
	pass # Replace with function body.


func _on_b_released() -> void:
	b_pressed = false
	pass # Replace with function body.
"

